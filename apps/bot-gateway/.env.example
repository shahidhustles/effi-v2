# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MESSAGE_DEDUPE_PATH=.data/telegram-message-ids.json

# Sarvam Saaras v3 STT and Bulbul v3 TTS
SARVAM_API_KEY=
# Cartesia Sonic 3 TTS fallback. A voice ID is required when enabled.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Vercel AI Gateway
AI_GATEWAY_API_KEY=
EFFI_AI_MODEL=meta/muse-spark-1.2-contributor
EFFI_AI_FALLBACK_MODEL=google/gemini-3.6-flash

# Authentication callback integration
EFFI_AUTHENTICATION_BASE_URL=
EFFI_AUTH_CALLBACK_SECRET=

# Loopback/public URL and shared secret used to re-enter Eve from Baileys socket events.
EFFI_INTERNAL_BASE_URL=http://127.0.0.1:3000
EFFI_INTERNAL_DISPATCH_SECRET=

# Effi-controlled media storage
EFFI_MEDIA_ROOT=.effi/media

# WhatsApp via the staged Baileys transport. Keep these directories on a
# durable, encrypted, access-controlled volume.
# Chat SDK state, provider-ID claims, and Baileys auth are stored below WHATSAPP_AUTH_DIR.
WHATSAPP_AUTH_DIR=/var/lib/effi/whatsapp-auth
WHATSAPP_MEDIA_DIR=/var/lib/effi/whatsapp-media

# Optional E.164 number without the leading + for WhatsApp pairing-code login.
WHATSAPP_PHONE_NUMBER=
