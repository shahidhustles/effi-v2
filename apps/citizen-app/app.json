{
  "expo": {
    "name": "Effi",
    "slug": "effi-citizen",
    "scheme": "effi",
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "@clerk/expo",
        {
          "appleSignIn": false
        }
      ]
    ],
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.anonymous.efficitizen"
    },
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.anonymous.effi-citizen"
    }
  }
}
